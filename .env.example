# ---------------------------------------------------------------------------
# Bloom configuration. Copy to .env.local for development.
# Never commit real secrets. Variables without NEXT_PUBLIC_ stay on the server.
# ---------------------------------------------------------------------------

# Postgres connection used by the server (RLS is enforced by switching to the
# `authenticated` role per request). For Supabase, use the *direct* or
# session-mode pooler connection string (LISTEN/NOTIFY needs a session).
DATABASE_URL=postgres://postgres:bloom-local-dev@127.0.0.1:5432/bloom
BLOOM_DB_POOL_MAX=10

# Signs the session cookie for the local auth backend. 32+ random characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-to-32-plus-random-characters

# Authentication backend: "local" (default; demo/dev/tests) or "supabase".
BLOOM_AUTH_BACKEND=local

# Supabase (only when BLOOM_AUTH_BACKEND=supabase or BLOOM_STORAGE_BACKEND=supabase).
# The service role key is server-only and must never be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Private file storage: "local" (files under BLOOM_UPLOAD_DIR) or "supabase".
BLOOM_STORAGE_BACKEND=local
BLOOM_UPLOAD_DIR=.data/uploads
BLOOM_STORAGE_BUCKET=bloom-private

# AI. Without ANTHROPIC_API_KEY Bloom runs in clearly labelled simulation mode.
# BLOOM_AI_MODE: "auto" (live when a key is present) or "simulated" (force).
ANTHROPIC_API_KEY=
BLOOM_AI_MODE=auto
# Model names are configuration, not code. Per-workflow overrides are optional.
BLOOM_AI_MODEL=claude-sonnet-5-5
BLOOM_AI_MODEL_FACILITATOR=
BLOOM_AI_MODEL_TUTOR=
BLOOM_AI_MODEL_SYNTHESIS=
BLOOM_AI_MODEL_LESSON=
BLOOM_AI_MODEL_REPORT=
BLOOM_AI_TIMEOUT_MS=20000

# Shows the "Demo mode — fictional data" banner and demo account hints.
BLOOM_DEMO_MODE=true
# How long a classroom join code stays valid for new joiners.
BLOOM_JOIN_CODE_TTL_MINUTES=120
